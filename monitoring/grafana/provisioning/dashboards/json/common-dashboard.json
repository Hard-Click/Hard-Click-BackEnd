            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity"
