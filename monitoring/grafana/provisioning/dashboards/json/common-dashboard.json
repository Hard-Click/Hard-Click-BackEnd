      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus_ds"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"hard-click\", uri=~\"$uri_filter\", status=~\"4..|5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{application=\"hard-click\", uri=~\"$uri_filter\"}[1m]))",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "URI별 RPS 추이",
