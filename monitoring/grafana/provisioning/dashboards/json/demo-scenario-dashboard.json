{
  "uid": "demo-scenario-v2",
  "title": "발표 시연 — 실시간 API 모니터링",
  "timezone": "browser",
  "refresh": "3s",
  "time": { "from": "now-5m", "to": "now" },
  "style": "dark",
  "templating": {
    "list": [
      {
        "name": "stage",
        "type": "custom",
        "label": "시나리오",
        "current": { "text": "막1 — 인증  |  POST /api/auth/login", "value": "/api/auth/login" },
        "options": [
          { "text": "막1 — 인증  |  POST /api/auth/login",                               "value": "/api/auth/login",                                          "selected": true },
          { "text": "막2 — 결제  |  POST /api/orders  ·  POST /api/payment/webhook",     "value": "/api/orders|/api/payment/webhook",                          "selected": false },
          { "text": "막3 — 강의재생  |  GET /api/lessons/{id}/video-url",                "value": "/api/lessons/.*/video-url|/api/study-timers/sessions/.*/heartbeat", "selected": false },
          { "text": "막4 — 커뮤니티  |  POST /api/community/posts  ·  댓글  ·  채택",   "value": "/api/community/posts.*",                                    "selected": false },
          { "text": "막5 — 신고  |  POST /api/reports  ·  PATCH /api/admin/reports/{id}","value": "/api/reports|/api/admin/reports/.*",                         "selected": false }
        ],
        "query": "막1 — 인증  |  POST /api/auth/login,막2 — 결제  |  POST /api/orders  ·  POST /api/payment/webhook,막3 — 강의재생  |  GET /api/lessons/{id}/video-url,막4 — 커뮤니티  |  POST /api/community/posts  ·  댓글  ·  채택,막5 — 신고  |  POST /api/reports  ·  PATCH /api/admin/reports/{id}",
        "hide": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "AVG LATENCY",
      "type": "stat",
      "gridPos": { "h": 9, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null },
            { "color": "#E0B400", "value": 200 },
            { "color": "#C4162A", "value": 1000 }
          ]},
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "value", "justifyMode": "auto" },
      "targets": [{
        "expr": "rate(http_server_requests_seconds_sum{job=\"hard-click-backend\",uri=~\"$stage\"}[1m]) / rate(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\"}[1m]) * 1000",
        "legendFormat": "avg latency"
      }]
    },
    {
      "id": 2,
      "title": "P95 LATENCY",
      "type": "stat",
      "gridPos": { "h": 9, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null },
            { "color": "#E0B400", "value": 500 },
            { "color": "#C4162A", "value": 2000 }
          ]},
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "value", "justifyMode": "auto" },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"hard-click-backend\",uri=~\"$stage\"}[1m])) * 1000",
        "legendFormat": "p95 latency"
      }]
    },
    {
      "id": 3,
      "title": "ERROR RATE",
      "type": "stat",
      "gridPos": { "h": 9, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null },
            { "color": "#E0B400", "value": 0.01 },
            { "color": "#C4162A", "value": 0.05 }
          ]},
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "value", "justifyMode": "auto" },
      "targets": [{
        "expr": "rate(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\",status=~\"4..|5..\"}[1m]) / rate(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\"}[1m])",
        "legendFormat": "error rate"
      }]
    },
    {
      "id": 4,
      "title": "RPS",
      "type": "stat",
      "gridPos": { "h": 9, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps", "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null },
            { "color": "#5794F2", "value": 1 }
          ]},
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "value", "justifyMode": "auto" },
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\"}[1m]))",
        "legendFormat": "rps"
      }]
    },
    {
      "id": 5,
      "title": "요청 성공",
      "type": "stat",
      "gridPos": { "h": 9, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null }
          ]},
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "value", "justifyMode": "auto" },
      "targets": [{
        "expr": "increase(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\",status=~\"2..\"}[5m])",
        "legendFormat": "성공"
      }]
    },
    {
      "id": 6,
      "title": "요청 실패",
      "type": "stat",
      "gridPos": { "h": 9, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null },
            { "color": "#C4162A", "value": 1 }
          ]},
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto", "textMode": "value", "justifyMode": "auto" },
      "targets": [{
        "expr": "increase(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\",status=~\"4..|5..\"}[5m])",
        "legendFormat": "실패"
      }]
    },
    {
      "id": 7,
      "title": "P95 Latency Trend",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus_ds" },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "#37872D", "value": null },
            { "color": "#E0B400", "value": 500 },
            { "color": "#C4162A", "value": 2000 }
          ]}
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{job=\"hard-click-backend\",uri=~\"$stage\"}[1m])) * 1000",
          "legendFormat": "{{uri}} p95"
        },
        {
          "expr": "rate(http_server_requests_seconds_sum{job=\"hard-click-backend\",uri=~\"$stage\"}[1m]) / rate(http_server_requests_seconds_count{job=\"hard-click-backend\",uri=~\"$stage\"}[1m]) * 1000",
          "legendFormat": "{{uri}} avg"
        }
      ]
    }
  ]
}